{
  "slug": "presentational-construction",
  "title": "Presentational Construction",
  "definition": "A construction that introduces a referent onto the discourse stage, typically asserting its presence at or arrival in a location salient to the speech situation. Structurally similar to [term:existential-predicate]s, but oriented toward pointing out or presenting a specific (often identifiable) referent rather than asserting bare existence. Strategies include non-verbal deictic expressions ('Here's X'), topic-comment juxtaposition, and grammaticalized verbs from perception roots (French voici/voilà from voir 'see').",
  "relatedTerms": ["existential-predicate", "copula", "predicate"],
  "examples": [
    {
      "id": "pres-ex1",
      "sourceLanguage": "English",
      "translation": "THERE'S my keys!",
      "notes": "Presentational use of there's: the referent (my keys) is specific and identifiable, contrasting with existential 'There are keys on the table' where the subject is indefinite.",
      "morphemes": [
        {
          "id": "m1", "surface": "THERE'S",
          "segments": [{ "form": "there", "gloss": "PRES" }, { "form": "'s", "gloss": "COP.PRS.3SG" }],
          "roles": { "Grammatical": ["presentational-particle", "copula"], "Predication": ["predicate"] }
        },
        {
          "id": "m2", "surface": "my keys",
          "segments": [{ "form": "my keys", "gloss": "1SG.POSS key.PL" }],
          "roles": {
            "Grammatical": ["subject", "NP-head"],
            "Predication": ["subject-of-predication"]
          }
        }
      ]
    },
    {
      "id": "pres-ex2",
      "sourceLanguage": "Kagayanen",
      "translation": "Anen di mama an. ('The man is here.')",
      "notes": "The identifiable-existential particle anen (vs. indefinite may) introduces a referent whose presence is expected or salient ('We've been expecting him').",
